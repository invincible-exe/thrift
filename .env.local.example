# 10/10 Thrifts — environment variables
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# ------------------------------------------------------------------
# Supabase (required for accounts, checkout, selling, wishlist, admin)
# Create a project at https://supabase.com, run supabase/migrations/0001_init.sql
# in the SQL editor, then copy these from Project Settings → API.
# Without them the app runs in preview mode with the demo catalog only.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — used by the M-Pesa webhook and admin routes. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: grant /admin access by user id (instead of profiles.role = 'admin').
# Find your id under Authentication → Users.
NEXT_PUBLIC_ADMIN_UID=

# ------------------------------------------------------------------
# Paystack (required for live checkout — M-Pesa + cards, and seller payouts)
# See docs/PAYMENTS.md. Create an account at https://paystack.com and copy
# your secret key (test keys work in test mode — run supabase/migrations/
# 0014_paystack.sql too).
# ------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Public HTTPS URL Paystack redirects buyers to after a card payment, e.g.
# https://your-domain.com/api/payments/card/callback
PAYSTACK_CARD_CALLBACK_URL=

# Local dev only: without PAYSTACK_SECRET_KEY, checkout stays clickable by
# running a server-side simulation (still via the service role — there is no
# client-side purchase path). Never set this in production.
ALLOW_SIMULATED_MPESA=true

# ------------------------------------------------------------------
# Legacy Daraja vars (unused after the Paystack switch — kept so historical
# rows/payouts can still be reconciled; new payments never read them):
# MPESA_ENV, MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET, MPESA_SHORTCODE,
# MPESA_PASSKEY, MPESA_CALLBACK_URL, MPESA_B2C_*
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Email (optional — sellers get an email when a listing is approved/rejected)
# https://resend.com — create an API key, then set EMAIL_FROM.
# ------------------------------------------------------------------
RESEND_API_KEY=
# Sender shown on listing notification emails.
# NOTE: Resend requires a verified from-domain — a Gmail address needs a
# verified custom domain to send reliably; otherwise use onboarding@resend.dev
# (delivers only to your own account email) for testing.
EMAIL_FROM=10/10 Thrifts <1010thriftss@gmail.com>
# Absolute site URL used for links inside emails, e.g. https://1010thrifts.ke
APP_URL=

# Shared secret that authenticates the DB→app email webhook (pg_net). The
# admin SQL functions fire /api/notifications/email with this value in the
# x-webhook-secret header. MUST match the value stored in the database:
#   insert into public.app_settings (key, value) values
#     ('email_webhook_url', 'https://your-domain.com/api/notifications/email'),
#     ('email_webhook_secret', 'SAME_SECRET_AS_HERE')
#   on conflict (key) do update set value = excluded.value;
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-string
SUPABASE_JWT_SECRET=PASTE_FROM_DASHBOARD
# Canonical public origin for auth/email confirmation links (e.g. your ngrok or deployed URL).
# Without it, email links bake in the origin used at sign-up (localhost breaks on phones).
NEXT_PUBLIC_SITE_URL=https://your-public-url.example

# Shared secret for the hourly payout sweep cron (Vercel Cron / Supabase pg_cron ->
# /api/cron/payout-sweep). Must match payout_sweep_secret in Supabase app_settings.
CRON_SECRET=replace-with-a-long-random-string
